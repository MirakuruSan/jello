; Jello installer hooks (Tauri NSIS). Jello registers its shell integration at
; runtime under HKCU (src/file_assoc.rs, src/deeplink.rs); remove all of it on
; uninstall so "Open with" and Default Apps don't keep a dead entry.

!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegKey HKCU "Software\Classes\JelloHTML"
  DeleteRegKey HKCU "Software\Classes\JelloURL"
  DeleteRegKey HKCU "Software\Classes\Applications\jello.exe"
  DeleteRegKey HKCU "Software\Clients\StartMenuInternet\Jello"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Jello"
  DeleteRegKey HKCU "Software\Classes\jello"
  DeleteRegKey HKCU "Software\Jello"
  DeleteRegValue HKCU "Software\Classes\.htm\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.html\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.shtml\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.xht\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.xhtml\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.mht\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.mhtml\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.pdf\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.svg\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.webp\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.avif\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.gif\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.png\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.jpg\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.jpeg\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.bmp\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.ico\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.mp4\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.webm\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.ogg\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.ogv\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.mp3\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.wav\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.m4a\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.flac\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.opus\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.txt\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.json\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.xml\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.md\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.log\OpenWithProgids" "JelloHTML"
  DeleteRegValue HKCU "Software\Classes\.csv\OpenWithProgids" "JelloHTML"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
